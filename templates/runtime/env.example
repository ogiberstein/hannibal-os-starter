# Copy this to .env in a private/local instance. Do not commit real .env files.

# Runtime selection
AGENT_RUNTIME=RUNTIME_NAME_HERE
RUNTIME_HOME=LOCAL_RUNTIME_HOME_HERE
RUNTIME_REF=PINNED_RUNTIME_VERSION_HERE
WORKSPACE_DIR=LOCAL_WORKSPACE_DIR_HERE

# Messaging adapter credentials — values belong in local .env or a secret manager only.
MODEL_API_KEY=SET_LOCALLY_ONLY
MESSAGING_BOT_TOKEN=SET_LOCALLY_ONLY

# Safety defaults
DIAGNOSTICS_PRINT_VALUES=false
REQUIRE_HUMAN_APPROVAL_FOR_HIGH_RISK_ACTIONS=true
