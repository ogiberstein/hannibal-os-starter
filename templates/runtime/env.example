# Copy this to .env in a private/local instance. Do not commit real .env files.

# Runtime selection
AGENT_RUNTIME=RUNTIME_NAME_HERE
RUNTIME_HOME=LOCAL_RUNTIME_HOME_HERE
RUNTIME_REF=PINNED_RUNTIME_VERSION_HERE
WORKSPACE_DIR=LOCAL_WORKSPACE_DIR_HERE

# Hermes-compatible managed deployments: runtime workload isolation contract
# Use presence/symbol checks in public templates; prove live isolation only with real deployment cgroup smoke evidence.
HERMES_GATEWAY_SESSION=1
HERMES_TERMINAL_SYSTEMD_ISOLATION=1
HERMES_TERMINAL_MEMORY_HIGH=TERMINAL_MEMORY_HIGH_HERE
HERMES_TERMINAL_MEMORY_MAX=TERMINAL_MEMORY_MAX_HERE
HERMES_TERMINAL_MEMORY_SWAP_MAX=TERMINAL_MEMORY_SWAP_MAX_HERE
HERMES_LSP_MEMORY_HIGH=LSP_MEMORY_HIGH_HERE
HERMES_LSP_MEMORY_MAX=LSP_MEMORY_MAX_HERE
HERMES_LSP_MEMORY_SWAP_MAX=LSP_MEMORY_SWAP_MAX_HERE

# Messaging adapter credentials — values belong in local .env or a secret manager only.
MODEL_API_KEY=SET_LOCALLY_ONLY
MESSAGING_BOT_TOKEN=SET_LOCALLY_ONLY

# Safety defaults
DIAGNOSTICS_PRINT_VALUES=false
REQUIRE_HUMAN_APPROVAL_FOR_HIGH_RISK_ACTIONS=true
