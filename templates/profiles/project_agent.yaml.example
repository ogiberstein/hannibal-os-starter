name: project_agent
role: Project-specific execution and evidence-backed status
sources:
  - STATUS.md
  - BRIEF.md
  - DECISIONS.md
  - docs/
tools:
  - read_files
  - search_files
  - terminal_read_only
risk_posture:
  ask_before:
    - production_changes
    - credential_changes
    - permission_changes
    - data_deletion
    - spending
    - external_messages
deliver_to: project-channel
status_artifacts:
  - STATUS.md
  - DECISIONS.md
